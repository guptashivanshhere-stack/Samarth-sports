# --- Supabase Database & Auth (Client-side) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Service Role (Server-side ONLY - never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Owner Authorization Allowlist ---
OWNER_EMAIL_ALLOWLIST=guptashivansh724@gmail.com

# --- Razorpay Payment Gateway (Server-side & Webhooks) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- WhatsApp Business Platform / Cloud API ---
WHATSAPP_API_TOKEN=EAAB_your_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_OWNER_NOTIFY_NUMBER=+919876543210

# --- Application Base URL ---
VITE_APP_URL=http://localhost:5173
